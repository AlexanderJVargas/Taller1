# Copie este archivo como db.properties (no se sube a GitHub).
#
# Opcion 1 - Base en la nube (Neon): pegue la cadena de conexion completa que da Neon.
# url=postgresql://usuario:contrasena@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Opcion 2 - Base local (pgAdmin):
url=jdbc:postgresql://localhost:5432/Biblio
usuario=postgres
contrasena=
#
# Tambien puede definir la variable de entorno BIBLIO_DB_URL con la cadena de conexion;
# si existe, se usa en lugar de este archivo.
